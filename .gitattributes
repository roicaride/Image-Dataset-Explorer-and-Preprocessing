*.r text eol=lf
*.R text eol=lf
*.m text eol=lf
*.f text eol=lf
*.f90 text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.scala text eol=lf
*.php text eol=lf
*.rb text eol=lf
