# Configuración de archivos para Git

# Archivos de texto que deben usar LF (Linux/Unix)
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Jupyter notebooks
*.ipynb text eol=lf

# Archivos binarios que no deben ser procesados
*.zip binary
*.mat binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.bmp binary
*.tiff binary
*.tif binary
*.h5 binary
*.hdf5 binary
*.pkl binary
*.pickle binary
*.joblib binary
*.pth binary
*.pt binary
*.onnx binary
*.docx binary
*.pdf binary

# Archivos de configuración
.gitignore text eol=lf
.gitattributes text eol=lf
.gitkeep text eol=lf

# Archivos de documentación
*.rst text eol=lf
*.tex text eol=lf

# Archivos de código fuente
*.c text eol=lf
*.cpp text eol=lf
